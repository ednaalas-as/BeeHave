# Non-secret BeeHave staging settings (/etc/beehave/staging.env). Secrets come from SSM:
#   /beehave/staging/PGPASSWORD, /beehave/staging/RESEND_API_KEY
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
TRUST_PROXY=loopback
DATABASE_URL=postgres://beehave_app@<rds-endpoint>:5432/beehave_staging?sslmode=verify-full
NODE_EXTRA_CA_CERTS=/etc/beehave/rds-global-bundle.pem
WEB_ORIGIN=https://<staging-host>
APP_PUBLIC_URL=https://<staging-host>
PASSWORD_RESET_EMAIL_FROM=<verified sender>
BEEHAVE_RECORDING_ROOT=/var/lib/beehave/brtc
DISABLE_DEMO=true
# Public sign-up off; build the web bundle with VITE_DISABLE_REGISTRATION=true to hide the link.
DISABLE_REGISTRATION=true
