# BeeHave agent settings. No secrets belong here; the device key is loaded from pairing.
# LAN development only: this is the Mac's DHCP address and changes when the lease changes.
BEEHAVE_API_URL=http://192.168.1.88:3001
BEEHAVE_HEARTBEAT_SECONDS=30
BEEHAVE_POLL_SECONDS=10
# Offline-first observation sync (sync.py). Off unless enabled. Sessions before
# BEEHAVE_SYNC_FIRST_SESSION are history and are never sent automatically.
# BEEHAVE_SYNC_ENABLED=1
# BEEHAVE_SYNC_FIRST_SESSION=20261020T124852Z
# Optional safety cap on the total number of observations ever queued (controlled tests).
# BEEHAVE_SYNC_ADMIT_LIMIT=5
# Near-real-time while online: poll every 10 s; at most 100 observations per batch;
# a backlog drains in such batches spaced 2 s apart.
# BEEHAVE_SYNC_SECONDS=10
# BEEHAVE_SYNC_BATCH=100
# BEEHAVE_SYNC_BACKLOG_PAUSE_SECONDS=2
# Automatic BRTC audio transfer: disabled until the controlled WAV test is approved.
# Only metadata-confirmed recordings in sync.sqlite3 qualify; originals are retained.
# Set BOTH for the first test. Do not remove the selector until broader upload is approved.
# BEEHAVE_AUDIO_ENABLED=1
# BEEHAVE_AUDIO_RECORDING_ID=pi_<approved recording identity>
# BEEHAVE_AUDIO_SECONDS=2
# BEEHAVE_AUDIO_TIMEOUT_SECONDS=20
