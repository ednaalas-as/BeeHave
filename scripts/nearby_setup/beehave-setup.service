[Unit]
Description=BeeHave nearby Wi-Fi setup and pairing (no monitoring access)
After=NetworkManager.service avahi-daemon.service
Wants=NetworkManager.service avahi-daemon.service

[Service]
Type=simple
ExecStart=/opt/beehave-setup/venv/bin/python /opt/beehave-setup/service.py
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=beehave-setup
StateDirectoryMode=0700
# Holds agent.sock, the read-only network status/scan socket for the BeeHave agent.
RuntimeDirectory=beehave-setup
RuntimeDirectoryMode=0755
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/beehave-setup /etc/NetworkManager/system-connections
PrivateTmp=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
